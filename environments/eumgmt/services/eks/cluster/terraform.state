            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::682331604648:oidc-provider/oidc.eks.eu-west-2.amazonaws.com/id/DD9C03E1D12C707818F395E287C2996B\"\n      },\n      \"Condition\": {\n        \"StringLike\": {\n          \"oidc.eks.eu-west-2.amazonaws.com/id/DD9C03E1D12C707818F395E287C2996B:aud\": \"sts.amazonaws.com\",\n          \"oidc.eks.eu-west-2.amazonaws.com/id/DD9C03E1D12C707818F395E287C2996B:sub\": \"system:serviceaccount:*:*\"\n        }\n      }\n    }\n  ]\n}",
