data "aws_eks_cluster_auth" "{{ cluster_name }}" {
  name = "{{ cluster_name }}"
}

provider "kubernetes" {  
  alias = "{{ cluster_name }}"
  host                   = "{{ endpoint }}"
  cluster_ca_certificate = base64decode("{{ cluster_ca_certificate }}")
  token                  = data.aws_eks_cluster_auth.{{ cluster_name }}.token
   exec {
    api_version = "client.authentication.k8s.io/v1"
    command     = "aws"
    args = ["eks", "get-token", "--cluster-name", "{{ cluster_name }}"]    
  }
}
module "configmap_creation_{{ count_index }}" {
  source = "../../../../../modules/services/eks/configmap"  
 
  providers = { kubernetes = kubernetes.{{ cluster_name }} }

  aws-auth_context = local.aws-auth_context[0]
  #aws-auth_context = local.aws-auth_context[{{ count_index }}]
  #aws_auth_additional_labels = local.aws_auth_additional_labels[{{ count_index }}]

}