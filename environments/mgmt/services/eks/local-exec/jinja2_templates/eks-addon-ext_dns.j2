data "aws_eks_cluster_auth" "{{ cluster_name }}" {
  name = "{{ cluster_name }}"
}
provider "kubernetes" {  
  alias = "{{ cluster_name }}"
  host                   = "{{ endpoint }}"
  cluster_ca_certificate = base64decode("{{ cluster_ca_certificate }}")
  token                  = data.aws_eks_cluster_auth.{{ cluster_name }}.token
   exec {
    api_version = "client.authentication.k8s.io/v1"
    command     = "aws"
    args = ["eks", "get-token", "--cluster-name", "{{ cluster_name }}"]    
  }
}

provider "helm" {
  alias = "{{ cluster_name }}"
  kubernetes {      
    host                   = "{{ endpoint }}"
    cluster_ca_certificate = base64decode("{{ cluster_ca_certificate }}")
    token                  = data.aws_eks_cluster_auth.{{ cluster_name }}.token
    exec {
      api_version = "client.authentication.k8s.io/v1"
      command     = "aws"
      args = ["eks", "get-token", "--cluster-name", "{{ cluster_name }}"]    
    }
  }
}

resource "null_resource" "module_set_initial_state_{{ count_index }}" {
  triggers = {
    always_run = "${timestamp()}"
  }
  provisioner "local-exec" {
    interpreter = ["bash", "-c"]
    command     = <<EOT
    echo 0 > ~/module_count
    EOT
  }
}

module "ext_dns_{{ count_index }}" {
  source = "../../../../../../modules/services/eks/addon/generic_kubectl"
  aws_region = "${var.aws_region}"
  aws_access_key = "${var.aws_access_key}"
  aws_secret_key = "${var.aws_secret_key}"  
  aws_caller_identity = data.aws_caller_identity.current.id  
  clusters = var.clusters
  clusters_info = local.clusters_info[{{ count_index }}]
  service_account_role_arns = local.service_account_role_arns
  sub_path = local.sub_path
  root_depends_on = null_resource.module_set_initial_state_{{ count_index }}
  module_count = {{ count_index }}
}