  source = "../../../../../../modules/services/eks/addon/helm"
  providers = { helm = helm.{{ cluster_name }} }
  helm_info = local.helm_info[{{ count_index }}]  
  helm_module_depends_on = ""
  #helm_module_depends_on = module.kubectl_apply_{{ count_index }}
}