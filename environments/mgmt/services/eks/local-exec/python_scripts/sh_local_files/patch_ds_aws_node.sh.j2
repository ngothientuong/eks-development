#!/bin/bash
aws eks update-kubeconfig --region {{ aws_region }} --name {{ cluster_name }} --kubeconfig ~/.kube/{{ cluster_name }}.config
kubectl --kubeconfig ~/.kube/{{ cluster_name }}.config -n kube-system patch daemonset aws-node --type='strategic' -p='{"spec":{"template":{"spec":{"nodeSelector":{"io.cilium/aws-node-enabled":"true"}}}}}'