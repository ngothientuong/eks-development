# BEGIN Global
Host *
  ServerAliveInterval 60
  TCPKeepAlive no
  StrictHostKeyChecking no
# END Global
# BEGIN tngo-mgmt
# tngo-mgmt-bastion
Host 18.116.155.0
  HostName 18.116.155.0
  User ec2-user
  IdentityFile ~/.ssh/tngo-keypair

Host 103.*
  User ec2-user
  IdentityFile ~/.ssh/tngo-keypair
