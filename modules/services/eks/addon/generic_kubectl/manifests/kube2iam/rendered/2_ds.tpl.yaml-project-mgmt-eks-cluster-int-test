---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: kube2iam
  namespace: kube2iam
  labels:
    app: kube2iam
spec:
  selector:
    matchLabels:
      name: kube2iam
  updateStrategy:    
    type: RollingUpdate        
  template:
    metadata:
      labels:
        name: kube2iam
    spec:
      serviceAccountName: kube2iam
      hostNetwork: true
      containers:
        - image: jtblin/kube2iam:latest
          imagePullPolicy: Always
          name: kube2iam
          args:
            #- "--auto-discover-base-arn"   # Can't query because metadata requires token. Not compatible          
            #- "--auto-discover-default-role"  # Can't query because metadata requires token. Not compatible          
            - "--app-port=8181"
            #- "--base-role-arn=arn:aws:iam::682331604648:role/project/project-eks-kube2iam_role"     # Conflict with auto-discover-base-arn       
            - "--iptables=true"
            - "--host-ip=$(HOST_IP)"
            - "--host-interface=eni+"
            #- "--node=$(NODE_NAME)"
            - "--verbose"
            - "--debug"
            - "--resolve-duplicate-cache-ips"
            - "--log-level=debug"
          env:
            - name: HOST_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            # - name: NODE_NAME
            #   valueFrom:
            #     fieldRef:
            #       fieldPath: spec.nodeName
          ports:
            - containerPort: 8181
              hostPort: 8181
              name: http
          securityContext:
            privileged: true